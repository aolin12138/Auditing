# Matplotlib style matched to the report template (Times, 16 cm text width).
# CEE guidelines: 10 pt is the minimum font size for ALL text in figures. Do not shrink figures after export.
font.family: serif
font.serif: Times New Roman, Times, Nimbus Roman, DejaVu Serif
mathtext.fontset: stix
font.size: 10
axes.titlesize: 10
axes.labelsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
figure.figsize: 6.3, 3.5      # full text width (16 cm); use 3.1 wide for half-width panels
figure.dpi: 150
savefig.format: pdf
savefig.bbox: tight
savefig.pad_inches: 0.02
axes.grid: True
grid.alpha: 0.3
axes.spines.top: False
axes.spines.right: False
lines.linewidth: 1.2
lines.markersize: 4
# Okabe-Ito colour-blind-safe palette
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])
pdf.fonttype: 42
